Pin_out "sdram_a[4]"  Loc = "IO_WC_B8";
Pin_out "sdram_a[5]"  Loc = "IO_WC_B7";
Pin_out "sdram_a[6]"  Loc = "IO_WB_B7";
Pin_out "sdram_a[7]"  Loc = "IO_WC_B6";
Pin_out "sdram_a[8]"  Loc = "IO_WC_A7";
Pin_out "sdram_a[9]"  Loc = "IO_WC_B0";
Pin_out "sdram_a[10]" Loc = "IO_NA_B1";
Pin_out "sdram_a[11]" Loc = "IO_WC_A0";
Pin_out "sdram_a[12]" Loc = "IO_WC_A8";

Pin_out "sdram_ba[0]" Loc = "IO_WB_A7";
Pin_out "sdram_ba[1]" Loc = "IO_WB_A8";
Pin_out "sdram_csn"   Loc = "IO_WB_A0";
Pin_out "sdram_cke"   Loc = "IO_WC_B1";
Pin_out "sdram_rasn"  Loc = "IO_WB_A6";
Pin_out "sdram_casn"  Loc = "IO_WB_B6";
Pin_out "sdram_wen"   Loc = "IO_WB_B0";

Pin_inout "sdram_d[0]"  Loc = "IO_WB_B4";
Pin_inout "sdram_d[1]"  Loc = "IO_WB_B2";
Pin_inout "sdram_d[2]"  Loc = "IO_WB_A4";
Pin_inout "sdram_d[3]"  Loc = "IO_WB_A2";
Pin_inout "sdram_d[4]"  Loc = "IO_WB_A5";
Pin_inout "sdram_d[5]"  Loc = "IO_WB_B5";
Pin_inout "sdram_d[6]"  Loc = "IO_WB_B1";
Pin_inout "sdram_d[7]"  Loc = "IO_WB_B3";
Pin_inout "sdram_d[8]"  Loc = "IO_WC_A6";
