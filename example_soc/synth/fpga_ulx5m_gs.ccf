# ULX5M-GS v005 / GateMate A1 (CCGM1A1)
# Pin mapping follows the current LiteX intergalaktik_ulx5m_gs platform.

Pin_in  "clk25" Loc = "IO_SB_A8" | SCHMITT_TRIGGER=true;
Pin_in  "btn0_n" Loc = "IO_EA_B4";

Pin_out "led_n[0]" Loc = "IO_SB_A0";
Pin_out "led_n[1]" Loc = "IO_SB_B0";
Pin_out "led_n[2]" Loc = "IO_SB_A1";
Pin_out "led_n[3]" Loc = "IO_SB_B1";
Pin_out "led_n[4]" Loc = "IO_SB_A2";
Pin_out "led_n[5]" Loc = "IO_SB_B2";
Pin_out "led_n[6]" Loc = "IO_SB_A3";
Pin_out "led_n[7]" Loc = "IO_SB_B3";

Pin_out "uart_tx" Loc = "IO_NB_B5";
Pin_in  "uart_rx" Loc = "IO_NA_B6";

Pin_out "sd_clk"  Loc = "IO_NA_A3";
Pin_out "sd_mosi" Loc = "IO_NA_B3";
Pin_in  "sd_miso" Loc = "IO_NA_A1" | PULLUP=true;
Pin_out "sd_csn"  Loc = "IO_NA_A2";

Pin_out "sdram_clk" Loc = "IO_WC_A1" | SLEW=fast;
Pin_out "sdram_a[0]"  Loc = "IO_WB_B8";
Pin_out "sdram_a[1]"  Loc = "IO_NA_A0";
